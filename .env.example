# Frontend-safe Supabase values (VITE_ variables are bundled into the browser)
# Project Settings > API: Project URL + anon / publishable key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_API_URL=http://localhost:3001

# Server-only values: never use these with a VITE_ prefix.
# SUPABASE_URL must be the HTTPS API URL, NOT a postgresql:// connection string.
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings > API: service_role / secret key (sb_secret_... or eyJ...)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
# Shared secret sent by the ElevenLabs webhook tools as X-EcoSathi-Secret
ELEVENLABS_WEBHOOK_SECRET=generate-a-long-random-secret
# Optional: owner for voice reports when the agent does not pass resident_id
VOICE_AGENT_USER_ID=
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Route planning depot (IIT Roorkee campus default)
CAMPUS_DEPOT_LAT=29.8645
CAMPUS_DEPOT_LNG=77.8960

# Optional seed account overrides
SEED_USER_EMAIL=demo@ecosathi.local
SEED_USER_PASSWORD=EcoSathiDemo123!
